# Razorpay (checkout is client-side with this key; secret stays server-only)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase Admin (server-only — used by API routes to write to Firestore)
# Paste these from your Firebase service account JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escape sequences from the JSON key literally in this value.
FIREBASE_PRIVATE_KEY=
