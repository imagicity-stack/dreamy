# ─── Razorpay ────────────────────────────────────────────────────────────────
# The key id is public by necessity: Razorpay's checkout runs in the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server-only. Signs and verifies payments.
RAZORPAY_KEY_SECRET=
# Server-only. The secret typed into Razorpay dashboard → Settings → Webhooks
# for the /api/razorpay/webhook endpoint. Without it, Razorpay's confirmation
# of a payment cannot be trusted and is refused, so a buyer whose browser died
# mid-payment has to be issued their pass by hand.
RAZORPAY_WEBHOOK_SECRET=

# ─── Firebase Admin (server-only) ────────────────────────────────────────────
# From the service account JSON: Firebase console → Project settings →
# Service accounts → Generate new private key. Used for Firestore and for
# verifying admin sign-ins. Never sent to the browser.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escape sequences from the JSON key literally in this value.
FIREBASE_PRIVATE_KEY=

# Storage bucket for images uploaded from the admin panel.
# Firebase console → Storage. Looks like `your-project.firebasestorage.app`
# (older projects: `your-project.appspot.com`).
FIREBASE_STORAGE_BUCKET=

# ─── Admin panel (server-only) ───────────────────────────────────────────────
# The project's Web API key: Firebase console → Project settings → General.
# It is used only on the server, to check an admin's password against Firebase.
FIREBASE_API_KEY=
# Who may use /admin. Comma-separated emails of Firebase Auth users.
# An account can also be let in with an `admin: true` custom claim.
ADMIN_EMAILS=

# ─── Mail (server-only) ──────────────────────────────────────────────────────
# Google Workspace SMTP. Everything the site does — a pass sold, a cosplay
# entry, a merch order, an interest-list signup, a failed payment, a refund —
# sends a copy to MAIL_TO, and a receipt to the buyer when they gave an address.
# Until these are set, nothing is emailed; passes are still sold and recorded,
# and the panel's overview says mail is off.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# The Workspace mailbox that does the sending.
SMTP_USER=
# An App Password for that mailbox (Google Account → Security → 2-Step
# Verification → App passwords). Not the account's own password.
SMTP_PASS=
# What the mail says it is from. A display name is fine:
# MAIL_FROM="MADOOZA <noreply@yourdomain.in>"
MAIL_FROM=
# The fest inbox that gets a copy of everything.
MAIL_TO=
# Where replies go, if not MAIL_TO.
MAIL_REPLY_TO=
