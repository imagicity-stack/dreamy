# Razorpay (checkout is client-side with this key; secret stays server-only)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase Admin (server-only — used by API routes to write to Firestore and to
# verify admin sign-ins). Paste these from your Firebase service account JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escape sequences from the JSON key literally in this value.
FIREBASE_PRIVATE_KEY=

# Firebase web config — safe to expose, used only so /admin can sign in.
# Firebase console → Project settings → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Who may use /admin. Comma-separated emails of Firebase Auth users.
# An account can also be let in with an `admin: true` custom claim.
ADMIN_EMAILS=
