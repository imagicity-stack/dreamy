# ─── Razorpay ────────────────────────────────────────────────────────────────
# The key id is public by necessity: Razorpay's checkout runs in the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server-only. Signs and verifies payments.
RAZORPAY_KEY_SECRET=

# ─── Firebase Admin (server-only) ────────────────────────────────────────────
# From the service account JSON: Firebase console → Project settings →
# Service accounts → Generate new private key. Used for Firestore and for
# verifying admin sign-ins. Never sent to the browser.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escape sequences from the JSON key literally in this value.
FIREBASE_PRIVATE_KEY=

# ─── Admin panel (server-only) ───────────────────────────────────────────────
# The project's Web API key: Firebase console → Project settings → General.
# It is used only on the server, to check an admin's password against Firebase.
FIREBASE_API_KEY=
# Who may use /admin. Comma-separated emails of Firebase Auth users.
# An account can also be let in with an `admin: true` custom claim.
ADMIN_EMAILS=
