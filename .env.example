# ─── Razorpay ────────────────────────────────────────────────────────────────
# The key id is public by necessity: Razorpay's checkout runs in the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server-only. Signs and verifies payments.
RAZORPAY_KEY_SECRET=
# Server-only. The secret typed into Razorpay dashboard → Settings → Webhooks
# for the /api/razorpay/webhook endpoint. Without it, Razorpay's confirmation
# of a payment cannot be trusted and is refused, so a buyer whose browser died
# mid-payment has to be issued their pass by hand.
RAZORPAY_WEBHOOK_SECRET=

# ─── Firebase Admin (server-only) ────────────────────────────────────────────
# From the service account JSON: Firebase console → Project settings →
# Service accounts → Generate new private key. Used for Firestore and for
# verifying admin sign-ins. Never sent to the browser.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escape sequences from the JSON key literally in this value.
FIREBASE_PRIVATE_KEY=

# Storage bucket for images uploaded from the admin panel.
# Firebase console → Storage. Looks like `your-project.firebasestorage.app`
# (older projects: `your-project.appspot.com`).
FIREBASE_STORAGE_BUCKET=

# ─── Admin panel (server-only) ───────────────────────────────────────────────
# The project's Web API key: Firebase console → Project settings → General.
# It is used only on the server, to check an admin's password against Firebase.
FIREBASE_API_KEY=
# Who may use /admin. Comma-separated emails of Firebase Auth users.
# An account can also be let in with an `admin: true` custom claim.
ADMIN_EMAILS=

# ─── The site's own address ──────────────────────────────────────────────────
# Where tickets live. QR codes encode <this>/t/<token>, so it has to be the
# address people's phones can actually reach. On Vercel this is filled in from
# the project's production URL when left blank; set it explicitly for a custom
# domain. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://madooza.com

# ─── Mail (server-only) ──────────────────────────────────────────────────────
# Google Workspace SMTP. Everything the site does — a pass sold, a cosplay
# entry, a merch order, an interest-list signup, a failed payment, a refund —
# sends a copy to MAIL_TO, and a receipt to the buyer when they gave an address.
# Until these are set, nothing is emailed; passes are still sold and recorded,
# and the panel's overview says mail is off.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# The Workspace mailbox that does the sending.
SMTP_USER=
# An App Password for that mailbox (Google Account → Security → 2-Step
# Verification → App passwords). Not the account's own password.
SMTP_PASS=
# What the mail says it is from. A display name is fine:
# MAIL_FROM="MADOOZA <noreply@yourdomain.in>"
MAIL_FROM=
# The fest inbox that gets a copy of everything.
MAIL_TO=
# Where replies go, if not MAIL_TO.
MAIL_REPLY_TO=

# ─── WhatsApp (server-only) ──────────────────────────────────────────────────
# Meta WhatsApp Business Cloud API, used to send the pass over WhatsApp as well
# as by email. Leave WHATSAPP_TOKEN or WHATSAPP_PHONE_NUMBER_ID empty and
# nothing is attempted — the email and the on-screen download are unaffected.
#
# Before any of this works you need, in Meta Business Manager: a verified
# business, a WhatsApp Business Account, a phone number registered to the API
# (it cannot also be signed into the WhatsApp app), and an APPROVED template.
#
# The template must have a DOCUMENT header and exactly three body variables:
#   {{1}} the holder's name   {{2}} the pass code   {{3}} the link to the pass
#
# A System User token, not a temporary one — the 24-hour test token in the
# dashboard expires overnight and the sends start failing silently.
WHATSAPP_TOKEN=
# "Phone number ID" from WhatsApp Manager. Not the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=
# The approved template's name, exactly as Meta lists it.
WHATSAPP_TEMPLATE=madooza_pass
# The template's language code, exactly as Meta lists it (often en or en_US —
# a mismatch here is the most common reason a send is refused).
WHATSAPP_TEMPLATE_LANG=en
# Graph API version. Meta retires one about two years after release; set this
# to whatever the dashboard currently offers if sends start failing.
WHATSAPP_API_VERSION=v21.0

# ─── Google Analytics (public) ───────────────────────────────────────────────
# GA4 measurement ID. Public pages only, same as the Meta Pixel below — never
# /gate, /admin or /t/<token>. Empty turns it off. Compiled into the bundle,
# so a change needs a redeploy.
NEXT_PUBLIC_GA_ID=G-4RD7WLG676

# ─── Meta Pixel (public) ─────────────────────────────────────────────────────
# Conversion tracking on the public pages only — never on /gate, /admin or
# /t/<token>, since a pass URL would otherwise be reported to Meta. Set it
# empty to turn the pixel off entirely, which is what a preview deploy wants.
# Compiled into the bundle, so a change needs a redeploy.
NEXT_PUBLIC_META_PIXEL_ID=1092847986552708
